{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "openfox websocket protocol",
  "description": "Inbound message vocabulary extracted from co-l/openfox develop by driving a live server. classification: deprecated = server must answer DEPRECATED_MESSAGE_TYPE; invalid_payload = answer INVALID_PAYLOAD for the empty payload sent; accepted = routed for processing.",
